# ============================================
# PM Copilot 环境配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# ---- OpenAI（必需）----
OPENAI_API_KEY=sk-proj-你的key填在这里

# ---- Anthropic（可选，没有就不填）----
# ANTHROPIC_API_KEY=

# ---- 所有 Agent 模型路由（纯 OpenAI 方案）----
AGENT_ORCHESTRATOR_MODEL=openai:gpt-4o-mini
AGENT_DECISION_MODEL=openai:gpt-4o
AGENT_PRD_WRITER_MODEL=openai:gpt-4o
AGENT_STRESS_TEST_MODEL=openai:gpt-4o-mini
AGENT_CRITIC_MODEL=openai:gpt-4o
AGENT_ORG_MEMORY_MODEL=openai:gpt-4o-mini

# ---- 默认模型 ----
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- 其他 ----
ENABLE_FALLBACK=true
FALLBACK_MODEL=openai:gpt-4o
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=pm_copilot_memory
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ---- 公开试用保护 ----
DEMO_MODE=false
DEMO_SKIP_STRESS=true
RATE_LIMIT_PER_IP_PER_DAY=20
ENABLE_DECISION_CLARIFY=true
